# Copy to .env.local. The dashboard runs on mock data until SOURCE=mqtt and the
# broker credentials below are filled in.

# mock | mqtt | netpie
SOURCE=mock

# --- NETPIE2020 cloud (only used when SOURCE=netpie) ---
NETPIE_CLIENT_ID=
NETPIE_TOKEN=
NETPIE_SECRET=
# device alias whose shadow we read (the gateway), and the command topic
NETPIE_DEVICE_ALIAS=gateway
NETPIE_CMD_TOPIC=sdl/cmd
# metric name for the Feed API (usually the gateway's Client ID)
NETPIE_FEED_METRIC=

# --- self-hosted EMQX (only used when SOURCE=mqtt) ---
MQTT_URL=mqtts://gw.embed.rachatat.com:8883
MQTT_CLIENT_ID=sdl-dashboard
MQTT_USERNAME=
MQTT_PASSWORD=
# Topic root used by the gateway firmware. @shadow/data/update is separate.
MQTT_TOPIC_PREFIX=@msg/sdl

# --- optional: keep history in Postgres (docker compose up -d) ---
# DATABASE_URL=postgres://sdl:sdl@127.0.0.1:5432/sdl
