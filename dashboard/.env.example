# Copy to .env.local. The dashboard runs on mock data until SOURCE=mqtt and the
# broker credentials below are filled in.

# mock | mqtt
SOURCE=mock

# --- self-hosted EMQX (only used when SOURCE=mqtt) ---
# TLS cert covers *.embed.rachatat.com, so use that hostname (it resolves to the same host)
# Topics: @msg/sdl/gw/{state,telemetry,status}, @msg/sdl/sensor/{telemetry,health,status}
MQTT_URL=mqtts://gw.embed.rachatat.com:8883
MQTT_CLIENT_ID=sdl-dashboard
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=@msg/sdl
# node the dashboard paints (telemetry from other nodes is ignored)
SDL_NODE_ID=N1
# set to 1 only when the broker uses a self-signed certificate
MQTT_TLS_INSECURE=

# --- history (read-only; EMQX writes the tables below) ---
# Use a SELECT-only role: sdl_sensor_telemetry + sdl_gw_state
# DATABASE_URL=postgres://sdl_dashboard:<password>@85.211.247.199.nip.io:5433/iot
# DATABASE_SSL=require

# --- optional basic auth in front of the dashboard ---
# DASHBOARD_USER=
# DASHBOARD_PASSWORD=
