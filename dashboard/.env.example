# Copy to .env.local. The dashboard runs on mock data until SOURCE=mqtt and the
# broker credentials below are filled in.

# mock | mqtt | netpie
SOURCE=mock

# --- self-hosted EMQX (only used when SOURCE=mqtt) ---
# TLS cert covers *.embed.rachatat.com, so use that hostname (it resolves to the same host)
MQTT_URL=mqtts://gw.embed.rachatat.com:8883
MQTT_CLIENT_ID=sdl-dashboard
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=@msg/sdl
# node the dashboard paints (telemetry from other nodes is ignored)
SDL_NODE_ID=N1
# set to 1 only when the broker uses a self-signed certificate
MQTT_TLS_INSECURE=

# --- history (read-only; EMQX writes public.sdl_sensor_telemetry) ---
# DATABASE_URL=postgres://iot:<password>@85.211.247.199.nip.io:5555/iot
# DATABASE_SSL=require

# --- NETPIE2020 cloud (only used when SOURCE=netpie) ---
NETPIE_CLIENT_ID=
NETPIE_TOKEN=
NETPIE_SECRET=
# device alias whose shadow we read (the gateway), and the command topic
NETPIE_DEVICE_ALIAS=gateway
NETPIE_CMD_TOPIC=sdl/cmd
# metric name for the Feed API (usually the gateway's Client ID)
NETPIE_FEED_METRIC=
